# LOCAL DEVELOPMENT ONLY. Compose already supplies these fixture defaults.
GUEST_SECRET=local-only-guest-signing-secret-rotate-before-sharing
SELLER_TOKEN=local-seller-a
SELLER_B_TOKEN=local-seller-b
ADMIN_TOKEN=local-admin
CUSTOMER_TOKEN=local-customer-a
CUSTOMER_B_TOKEN=local-customer-b
PAYMENT_MODE=mock
# To use a configured Razorpay TEST account, supply values privately in ignored .env:
# PAYMENT_MODE=razorpay-test
# RAZORPAY_KEY=rzp_test_...
# RAZORPAY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# OIDC deployment settings must be injected into the application containers.
# Base Compose uses public local fixtures, not a production environment.
# See docs/runbooks/oidc-and-session-recovery.md for required provider policy.
# OIDC_ISSUER=https://your-identity-provider.example
# OIDC_JWKS_URI=https://your-identity-provider.example/jwks
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_AUDIENCE=
# OIDC_REQUIRED_ACR=
# APP_URL=https://your-storefront.example
# AUTH_DATABASE_URL=
# AUTH_ENCRYPTION_KEY= # 32 random bytes, hex encoded; never commit a real key
